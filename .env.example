# 复制本文件为 .env，填入真实 key。.env 已被 .gitignore 排除，不会入库。
#
# 必填：至少一个密钥
ANTHROPIC_API_KEY=sk-your-key-here

# DeepSeek 的 Anthropic 兼容入口（用其它供应商就改这里）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 模型名（也可用 ANTHROPIC_MODEL）
CARRYCODE_MODEL=deepseek-v4-flash

# 可选：输出上限与超时
# CARRYCODE_MAX_TOKENS=8192
# CARRYCODE_TIMEOUT=120
